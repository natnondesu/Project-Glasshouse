# Copy to deployment/.env on the ops host and fill in. Generate secrets with: openssl rand -hex 24
TAG=latest
GLASSHOUSE_HOST=glasshouse.ops.oxygenci.com
GLASSHOUSE_PUBLIC_URL=https://glasshouse.ops.oxygenci.com
GLASSHOUSE_DATA_DIR=/data/services/services-data/glasshouse

POSTGRES_DB=glasshouse
POSTGRES_USER=glasshouse
# Hex only, so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=change-me-hex

GLASSHOUSE_OIDC_ISSUER=https://authelia.oxygenci.com
GLASSHOUSE_OIDC_CLIENT_ID=glasshouse
GLASSHOUSE_OIDC_CLIENT_SECRET=change-me
GLASSHOUSE_BOOTSTRAP_ADMIN=you@oxygenai.com
GLASSHOUSE_DEFAULT_ROLE=viewer
GLASSHOUSE_LOCAL_LOGIN=on
# The traefik-proxy network (confirmed 2026-10-18). See docs/go-live.md before changing it.
GLASSHOUSE_TRUST_PROXY=172.16.7.0/24

BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
