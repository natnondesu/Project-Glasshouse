{
  "name": "glasshouse",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @glasshouse/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @glasshouse/web e2e",
    "e2e:server": "pnpm --filter @glasshouse/web e2e:server",
    "e2e:auth": "pnpm --filter @glasshouse/web e2e:auth",
    "dev:server": "pnpm --filter @glasshouse/server dev",
    "test:db": "pnpm --filter @glasshouse/server test:db",
    "docker:build": "docker build -f docker/Dockerfile -t oxygenai/glasshouse:dev .",
    "smoke": "sh deployment/smoke.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
